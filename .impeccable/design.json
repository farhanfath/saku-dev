      "css": ".ds-primary{font-family:'Segoe UI', system-ui, sans-serif;font-size:12px;font-weight:600;min-height:40px;border:0;border-radius:6px;display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:10px 15px;white-space:nowrap;cursor:pointer;transition:background-color .16s ease-out,box-shadow .16s ease-out;background:var(--teal);color:white}.ds-primary:hover:not(:disabled){background:var(--teal-dark)}.ds-primary:focus-visible{outline:2px solid var(--focus);outline-offset:3px}.ds-primary:disabled{background:#e4ebed;color:#687d84;cursor:not-allowed}@media(prefers-reduced-motion:reduce){*,*::before,*::after{transition:none!important;animation:none!important}}"
    },
