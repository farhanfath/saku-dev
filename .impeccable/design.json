      "kind": "input",
      "refersTo": "name-field",
      "description": "An editable basename beside its protected extension; the wrapper owns focus.",
      "html": "<div class=\"ds-field\"><input class=\"ds-name\" value=\"Catatan rapat\" aria-label=\"Nama baru untuk Catatan rapat.txt\" /><span class=\"ds-extension\" title=\"Ekstensi dilindungi\">.txt</span></div>",
      "css": ".ds-field{display:flex;align-items:center;border:1px solid #748b94;border-radius:5px;background:white;overflow:hidden;max-width:320px}.ds-field:focus-within{border-color:var(--focus);box-shadow:0 0 0 2px #168c7b24}.ds-name{font-family:'Segoe UI', system-ui, sans-serif;font-size:12px;background:transparent;color:var(--ink);width:100%;min-width:0;padding:9px 10px;border:0;border-radius:5px;outline:none;caret-color:var(--teal)}.ds-name:focus-visible{outline:none}.ds-extension{font-family:'Segoe UI', system-ui, sans-serif;font-size:11px;color:#617981;padding:3px 9px 3px 0;max-width:90px;flex-shrink:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ds-field[aria-invalid=true]{border-color:#c26770}"
    },
    {
      "name": "Current Navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Current tool on the petrol navigation rail.",
      "html": "<nav class=\"ds-rail\" aria-label=\"Navigasi aplikasi\"><a class=\"ds-current\" href=\"#main\" aria-current=\"page\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 256 256\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"16\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M32 200 88 56l56 144M52 152h72M160 120h40a24 24 0 0 1 24 24v56M224 160h-40a20 20 0 0 0 0 40h16a24 24 0 0 0 24-24\"/></svg>Batch Rename</a></nav>",
      "css": ".ds-rail{background:#183f48;padding:18px;width:172px}.ds-current{font-family:'Segoe UI', system-ui, sans-serif;color:#f1fafa;background:#2e5961;display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:7px;text-decoration:none;font-size:13px;font-weight:600}.ds-current svg{color:#ace1d7;flex-shrink:0}.ds-current:focus-visible{outline:2px solid var(--focus);outline-offset:3px}"
    },
    {
      "name": "Workspace",
      "kind": "card",
      "refersTo": "workspace",
      "description": "Flat white editing surface with a toolbar and quieter status strip.",
      "html": "<section class=\"ds-workspace\" aria-label=\"Editor nama file\"><div class=\"ds-toolbar\"><h2 class=\"ds-title\">Daftar file</h2><span class=\"ds-count\">2</span></div><div class=\"ds-content\">Nama asli &nbsp;&nbsp; Nama baru</div><div class=\"ds-bottom\">File lain tidak akan ditimpa.</div></section>",
      "css": ".ds-workspace{font-family:'Segoe UI', system-ui, sans-serif;color:var(--ink);background:white;border:1px solid var(--line);border-radius:10px;overflow:hidden}.ds-toolbar{display:flex;align-items:center;gap:9px;padding:16px 20px;border-bottom:1px solid var(--line);min-height:63px;box-sizing:border-box}.ds-title{margin:0;font-size:13px;font-weight:600}.ds-count{background:#eef3f5;color:#526a73;border-radius:5px;padding:2px 7px;font-size:11px;font-variant-numeric:tabular-nums}.ds-content{padding:15px 20px;font-size:12px}.ds-bottom{padding:13px 20px;background:#fcfdfd;border-top:1px solid var(--line);font-size:10px;color:#607880}"
    },
    {
      "name": "Error Notice",
      "kind": "custom",
      "description": "Visible operation feedback uses a readable message alongside an inline icon.",
      "html": "<div class=\"ds-notice\" role=\"alert\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v6\"/><circle cx=\"12\" cy=\"17\" r=\".75\" fill=\"currentColor\" stroke=\"none\"/></svg>Nama file perlu diperiksa sebelum Apply.</div>",
      "css": ".ds-notice{font-family:'Segoe UI', system-ui, sans-serif;display:flex;align-items:flex-start;gap:10px;border-radius:6px;padding:12px 14px;font-size:12px;line-height:1.6;background:#fceced;color:#9c3540;overflow-wrap:anywhere}.ds-notice svg{flex-shrink:0;margin-top:1px}"
