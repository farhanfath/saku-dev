      "css": ".ds-secondary{font-family:'Segoe UI', system-ui, sans-serif;font-size:12px;font-weight:600;min-height:40px;border:0;border-radius:6px;display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:10px 15px;white-space:nowrap;cursor:pointer;transition:background-color .16s ease-out,box-shadow .16s ease-out;background:white;color:var(--ink);box-shadow:inset 0 0 0 1px #cddadd}.ds-secondary:hover:not(:disabled){background:#edf4f4}.ds-secondary:focus-visible{outline:2px solid var(--focus);outline-offset:3px}.ds-secondary:disabled{color:#6d7e85;background:#f4f7f8;box-shadow:inset 0 0 0 1px #dce5e8;cursor:not-allowed}@media(prefers-reduced-motion:reduce){*,*::before,*::after{transition:none!important;animation:none!important}}"
    },
    {
