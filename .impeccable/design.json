  "narrative": {
    "northStar": "The Clear Workbench",
    "overview": "The Clear Workbench turns a local file operation into a calm editing task. A cool white workspace sits beside a deep petrol rail; teal identifies deliberate actions and keyboard focus. Compact controls and aligned columns keep original and proposed filenames easy to compare.\n\nThe system uses native-feeling Windows typography, restrained rounding, and flat surfaces. Operational state stays readable through words and icons alongside colour. This record describes the implemented UI; project scope, decisions, and release status remain in D:\\vault\\desktop-local-tool-vault.",
    "keyCharacteristics": [
      "Cool white workspace with a petrol navigation rail.",
      "Compact, aligned file rows and visibly bounded edit fields.",
      "Teal actions and focus; words and icons explain state.",
      "Indonesian copy and a Windows system UI font."
    ],
    "rules": [
      {
        "name": "The Readable State Rule",
        "body": "Use colour together with a word and an icon for row state; the current UI distinguishes unchanged, changed, and invalid rows this way.",
        "section": "colors"
      },
      {
        "name": "The Quiet Depth Rule",
        "body": "Keep the main workspace flat; reserve a cast shadow and backdrop for modal confirmation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep original and proposed names visible together.",
      "Do use the established teal focus treatment on editable fields.",
      "Do pair changed, invalid, and recovery states with readable text and an icon.",
      "Do preserve the table's horizontal scrolling at narrow widths."
    ],
    "donts": [
      "Don't use colour alone to communicate file state.",
      "Don't turn the flat workspace into a stack of raised cards.",
      "Don't hide original names when a new name is being edited."
    ]
  }
}

