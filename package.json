{
  "name": "saku",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farhanfath/saku-dev.git"
  },
  "bugs": {
    "url": "https://github.com/farhanfath/saku-dev/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "desktop": "tauri dev",
    "desktop:build": "tauri build --bundles nsis",
    "test": "node --test tests/*.test.js",
    "test:desktop": "tauri build --debug --no-bundle --config tests/tauri.smoke.json && node tests/desktop-smoke.mjs && node tests/desktop-close.mjs && node tests/markdown-smoke.mjs",
    "test:markdown": "tauri build --debug --no-bundle --config tests/tauri.smoke.json && node tests/markdown-smoke.mjs",
    "test:close": "tauri build --debug --no-bundle --config tests/tauri.smoke.json && node tests/desktop-close.mjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@phosphor-icons/web": "^2.1.1",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.0.0",
    "vite": "^7.0.0"
  }
}
